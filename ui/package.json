{
  "name": "quantlet-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "QuantLet の Web 画面（React＋TypeScript）。入力・アップロード・API の呼び出し・結果の表示だけを行い、計算はしない",
  "scripts": {
    "dev": "node scripts/check-port.mjs 8091 && vite",
    "api": "node scripts/run-r.mjs ../server/server.R --port 8790",
    "build": "tsc -b && vite build",
    "preview": "node scripts/check-port.mjs 8091 && vite preview",
    "typecheck": "tsc -b",
    "lan": "npm run build && node scripts/check-port.mjs 8091 0.0.0.0 && node scripts/run-r.mjs ../server/server.R --host 0.0.0.0 --port 8091 --static ../ui/dist",
    "reconcile:a1": "node scripts/run-r.mjs ../server/reconciliation/a1/reconcile_a1.R",
    "reconcile:c1": "node scripts/run-r.mjs ../server/reconciliation/c1/reconcile_c1.R"
  },
  "dependencies": {
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
