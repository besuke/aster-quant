# R
.Rhistory
.RData
.Rproj.user/

# Node
node_modules/
ui/dist/
*.tsbuildinfo

# サーバーのローカルデータ（アップロード・実行結果・案件・取得した市場データ・ジョブ）。デモデータ（架空）は管理対象
/server/data/*
!/server/data/demo/
# 例外：掲示板のデモとして、サンプルレポート（架空）の案件だけを入れる。表示に使うファイルだけで、実行ログ（agents/・logs/）は入れない
!/server/data/cases/
/server/data/cases/*
!/server/data/cases/reports/
/server/data/cases/reports/*
!/server/data/cases/reports/RPT_20261115_153947_c76c/
/server/data/cases/reports/RPT_20261115_153947_c76c/agents/
/server/data/cases/reports/RPT_20261115_153947_c76c/logs/

# 個人用の設定・認証情報（server/tmp/.Renviron に Bloomberg の認証情報のパス、User-Agent、Aladdin の対応表のパスなどを書く）
/server/tmp/
.Renviron
.env
*.env
*.pem
*.key
*credential*
*secret*
config/*_local.*

# 照合の出力（再実行で作り直す。session_info と CSV は残す）
/server/tests/reconciliation/*/results/*.xlsx

~$*
*.tmp
.DS_Store
Thumbs.db

# 配備設定（実際のホスト名・IP アドレス）
/deploy.local.env
!/deploy.example.env

# この PC の設定（使う Rscript.exe など）
/settings.local.env
!/settings.example.env
